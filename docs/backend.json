
{
  "entities": {
    "Member": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Member",
      "type": "object",
      "description": "Represents a member of the association.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the member."
        },
        "nom": {
          "type": "string",
          "description": "The name of the member."
        },
        "email": {
          "type": "string",
          "description": "The email address of the member.",
          "format": "email"
        },
        "telephone": {
          "type": "string",
          "description": "The phone number of the member."
        },
        "adresse": {
          "type": "string",
          "description": "The address of the member."
        },
        "membershipStatus": {
          "type": "string",
          "description": "The current membership status of the member (e.g., active, inactive)."
        },
        "joinDate": {
          "type": "string",
          "description": "The date when the member joined the association.",
          "format": "date-time"
        },
        "doc": {
          "type": "string",
          "description": "Document type for the member."
        },
        "memo": {
          "type": "string",
          "description": "A memo for the member."
        },
        "role": {
          "type": "string",
          "description": "The role of the member within the association.",
          "default": "membre"
        }
      },
      "required": [
        "id",
        "nom"
      ]
    },
    "Payment": {
      "title": "Payment",
      "type": "object",
      "description": "Represents a single payment installment for a donation.",
      "properties": {
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "paymentMethod": { "type": "string", "enum": ["Carte de crédit", "Virement bancaire", "Espèces", "Chèque"] }
      },
      "required": ["amount", "date", "paymentMethod"]
    },
    "Donation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Donation",
      "type": "object",
      "description": "Represents a donation or contribution made by a member.",
      "properties": {
        "id": { "type": "string" },
        "memberId": { "type": "string" },
        "type": { "type": "string", "enum": ["Don", "Cotisation"] },
        "donationCategoryId": { "type": "string" },
        "totalAmount": { "type": "number" },
        "payments": {
          "type": "array",
          "items": { "$ref": "#/entities/Payment" }
        },
        "paymentStatus": { "type": "string", "enum": ["EN ATTENTE", "Partiel", "Payé"] },
        "memo": { "type": "string" },
        "cerfaEligible": { "type": "boolean" },
        "cerfaNumber": { "type": "string", "description": "The unique sequential number for the generated CERFA document." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "memberId",
        "type",
        "totalAmount",
        "cerfaEligible",
        "paymentStatus"
      ]
    },
    "Transaction": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Transaction",
      "type": "object",
      "description": "Represents a financial transaction.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the transaction."
        },
        "type": {
          "type": "string",
          "enum": ["Don", "Cotisation", "Événement"],
          "description": "The type of transaction."
        },
        "relatedId": {
          "type": "string",
          "description": "ID of the source document (e.g., Donation ID, Event Registration ID)."
        },
        "amount": {
          "type": "number",
          "description": "The amount of the transaction."
        },
        "date": {
          "type": "string",
          "description": "The date of the transaction.",
          "format": "date-time"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["Carte de crédit", "Virement bancaire", "Espèces", "Chèque"],
          "description": "The method of payment."
        },
        "memo": {
          "type": "string",
          "description": "A memo for the transaction."
        },
        "createdAt": {
          "type": "string",
          "description": "The creation date of the transaction record.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "type",
        "relatedId",
        "amount",
        "date"
      ]
    },
    "DonationCategory": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "DonationCategory",
      "type": "object",
      "description": "Represents a category for donations.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Admin": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Admin",
      "type": "object",
      "description": "Represents an administrator user of the application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the admin user."
        },
        "username": {
          "type": "string",
          "description": "The username of the admin user."
        },
        "email": {
          "type": "string",
          "description": "The email address of the admin user.",
          "format": "email"
        }
      },
      "required": [
        "id",
        "username",
        "email"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}/membre/{memberId}",
        "definition": {
          "entityName": "Member",
          "schema": {
            "$ref": "#/backend/entities/Member"
          },
          "description": "Stores member profiles under the user who created them."
        }
      },
      {
        "path": "/users/{userId}/donations/{donationId}",
        "definition": {
          "entityName": "Donation",
          "schema": {
            "$ref": "#/backend/entities/Donation"
          },
          "description": "Stores donations made."
        }
      },
       {
        "path": "/users/{userId}/transactions/{transactionId}",
        "definition": {
          "entityName": "Transaction",
          "schema": {
            "$ref": "#/backend/entities/Transaction"
          },
          "description": "Stores all financial transactions."
        }
      },
      {
        "path": "/donationCategories/{categoryId}",
        "definition": {
          "entityName": "DonationCategory",
          "schema": {
            "$ref": "#/backend/entities/DonationCategory"
          },
          "description": "Global categories for donations."
        }
      },
      {
        "path": "/roles_admin/{adminId}",
        "definition": {
          "entityName": "Admin",
          "schema": {
            "$ref": "#/backend/entities/Admin"
          },
          "description": "Collection containing documents representing admin users. Existence of a document with a specific UID grants admin privileges."
        }
      }
    ]
  }
}

    