/**
 * @fileOverview Firestore Security Rules for the association management application.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for member data, with public read access to donation categories.
 * Members can only access their own data and associated donations/CERFA forms.
 *
 * Data Structure:
 * - /members/{memberId}: Stores member profiles, accessible only to the member.
 * - /members/{memberId}/donations/{donationId}: Stores donations for each member, accessible only to the member.
 * - /members/{memberId}/donations/{donationId}/cerfa/{cerfaId}: Stores CERFA forms, accessible only to the member.
 * - /donationCategories/{donationCategoryId}: Stores donation categories, publicly readable.
 *
 * Key Security Decisions:
 * - Members can only access their own data.
 * - Donation categories are publicly readable.
 * - Data consistency is enforced between the path and document fields for member ownership.
 * - The rules avoid using `get()` calls by denormalizing `memberId` and `donationId` within the donation and CERFA documents.
 * - Write operations on members and their subcollections are restricted to the owner.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to member profiles based on ownership.
     * @path /members/{memberId}
     * @allow (create) - A user can create their own profile if the UID matches the memberId.
     * @allow (get, list, update, delete) - A user can read, update, or delete their own profile if the UID matches the memberId.
     * @deny (create) - A user cannot create a profile with a memberId that does not match their UID.
     * @deny (update, delete) - A user cannot update or delete another user's profile.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /members/{memberId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(memberId);
      allow list: if false;
      allow create: if isOwner(memberId) && request.resource.data.id == memberId;
      allow update: if isExistingOwner(memberId) && resource.data.id == request.resource.data.id;
      allow delete: if isExistingOwner(memberId);
    }

    /**
     * @description Grants access to donations based on member ownership.
     * @path /members/{memberId}/donations/{donationId}
     * @allow (create) - A user can create a donation under their profile if the memberId matches.
     * @allow (get, list, update, delete) - A user can read, update, or delete a donation under their profile if the memberId matches.
     * @deny (create) - A user cannot create a donation under another user's profile.
     * @deny (update, delete) - A user cannot update or delete a donation under another user's profile.
     * @principle Enforces document ownership and validates relational integrity between member and donation documents.
     */
    match /members/{memberId}/donations/{donationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(memberId);
      allow list: if isOwner(memberId);
      allow create: if isOwner(memberId) && request.resource.data.memberId == memberId;
      allow update: if isExistingOwner(memberId) && resource.data.memberId == request.resource.data.memberId;
      allow delete: if isExistingOwner(memberId);
    }

    /**
     * @description Grants access to CERFA forms based on member ownership.
     * @path /members/{memberId}/donations/{donationId}/cerfa/{cerfaId}
     * @allow (create) - A user can create a CERFA form under their donation if the memberId matches.
     * @allow (get, list, update, delete) - A user can read, update, or delete a CERFA form under their donation if the memberId matches.
     * @deny (create) - A user cannot create a CERFA form under another user's donation.
     * @deny (update, delete) - A user cannot update or delete a CERFA form under another user's donation.
     * @principle Enforces document ownership and validates relational integrity between member, donation, and CERFA documents.
     */
    match /members/{memberId}/donations/{donationId}/cerfa/{cerfaId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(memberId);
      allow list: if isOwner(memberId);
      allow create: if isOwner(memberId);
      allow update: if isExistingOwner(memberId);
      allow delete: if isExistingOwner(memberId);
    }

    /**
     * @description Grants public read access to donation categories.
     * @path /donationCategories/{donationCategoryId}
     * @allow (get, list) - Any user can read donation categories.
     * @deny (create, update, delete) - No user can create, update, or delete donation categories.
     * @principle Allows public read access while restricting write access.
     */
    match /donationCategories/{donationCategoryId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}