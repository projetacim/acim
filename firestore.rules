rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces ownership for member documents.
     * @path /members/{memberId}
     * @allow (create) - User with UID 'user_abc' can create a member document with ID 'user_abc'.
     * @allow (get, update, delete) - User with UID 'user_abc' can read, update, or delete their own member document ('user_abc').
     * @deny (create) - User with UID 'user_xyz' cannot create a member document with ID 'user_abc'.
     * @deny (get, update, delete) - User with UID 'user_xyz' cannot read, update, or delete member document 'user_abc'.
     * @principle Enforces document ownership for writes.
     */
    match /members/{memberId} {
      function isOwner(memberId) {
        return request.auth != null && request.auth.uid == memberId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(memberId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == memberId;
      allow update: if isOwner(memberId);
      allow delete: if isOwner(memberId);
    }

    /**
     * @description Enforces ownership for donation documents under a member.
     * @path /members/{memberId}/donations/{donationId}
     * @allow (create) - User with UID 'user_abc' can create a donation document under their member document.
     * @allow (get, update, delete) - User with UID 'user_abc' can read, update, or delete donation documents under their member document.
     * @deny (create) - User with UID 'user_xyz' cannot create a donation document under member document 'user_abc'.
     * @deny (get, update, delete) - User with UID 'user_xyz' cannot read, update, or delete donation documents under member document 'user_abc'.
     * @principle Enforces document ownership for writes.
     */
    match /members/{memberId}/donations/{donationId} {
      function isOwner(memberId) {
        return request.auth != null && request.auth.uid == memberId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      // Ensure the memberId in the path matches the authenticated user's UID
      allow get: if isSignedIn() && isOwner(memberId);
      allow list: if false; // disable listing for security
      allow create: if isSignedIn() && isOwner(memberId);
      allow update: if isSignedIn() && isOwner(memberId);
      allow delete: if isSignedIn() && isOwner(memberId);
    }

    /**
     * @description Enforces ownership for CERFA documents under a donation.
     * @path /members/{memberId}/donations/{donationId}/cerfa/{cerfaId}
     * @allow (create) - User with UID 'user_abc' can create a CERFA document under their donation document.
     * @allow (get, update, delete) - User with UID 'user_abc' can read, update, or delete CERFA documents under their donation document.
     * @deny (create) - User with UID 'user_xyz' cannot create a CERFA document under donation document 'donation_abc'.
     * @deny (get, update, delete) - User with UID 'user_xyz' cannot read, update, or delete CERFA documents under donation document 'donation_abc'.
     * @principle Enforces document ownership for writes.
     */
    match /members/{memberId}/donations/{donationId}/cerfa/{cerfaId} {
       function isOwner(memberId) {
        return request.auth != null && request.auth.uid == memberId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      // Ensure the memberId in the path matches the authenticated user's UID
      allow get: if isSignedIn() && isOwner(memberId);
      allow list: if false; // disable listing for security
      allow create: if isSignedIn() && isOwner(memberId);
      allow update: if isSignedIn() && isOwner(memberId);
      allow delete: if isSignedIn() && isOwner(memberId);
    }
  }
}