rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is an admin.
     */
    function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the requested user ID matches the authenticated user's ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the existing document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /members/{memberId} collection.
     * @path /members/{memberId}
     * @allow (create) User with admin role can create a member.
     * @deny (create) User without admin role cannot create a member.
     * @allow (get) User with admin role can get a member.
     * @deny (get) User without admin role cannot get a member.
     * @principle Only admins can manage members.
     */
    match /members/{memberId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for the /members/{memberId}/donations/{donationId} collection.
     * @path /members/{memberId}/donations/{donationId}
     * @allow (create) Member or admin can create a donation for the member.
     * @deny (create) Non-member and non-admin cannot create a donation.
     * @allow (get) Member or admin can get a donation for the member.
     * @deny (get) Non-member and non-admin cannot create a donation.
     * @principle Members and admins can manage donations for a member.
     */
    match /members/{memberId}/donations/{donationId} {
      allow get: if isAdmin() || isOwner(memberId);
      allow list: if isAdmin() || isOwner(memberId);
      allow create: if isAdmin() || isOwner(memberId);
      allow update: if isAdmin() || isOwner(memberId);
      allow delete: if isAdmin() || isOwner(memberId);
    }

    /**
     * @description Rules for the /members/{memberId}/donations/{donationId}/cerfa/{cerfaId} collection.
     * @path /members/{memberId}/donations/{donationId}/cerfa/{cerfaId}
     * @allow (create) Member or admin can create a CERFA form for the donation.
     * @deny (create) Non-member and non-admin cannot create a CERFA form.
     * @allow (get) Member or admin can get a CERFA form for the donation.
     * @deny (get) Non-member and non-admin cannot create a CERFA form.
     * @principle Members and admins can manage CERFA forms for a donation.
     */
    match /members/{memberId}/donations/{donationId}/cerfa/{cerfaId} {
      allow get: if isAdmin() || isOwner(memberId);
      allow list: if isAdmin() || isOwner(memberId);
      allow create: if isAdmin() || isOwner(memberId);
      allow update: if isAdmin() || isOwner(memberId);
      allow delete: if isAdmin() || isOwner(memberId);
    }

    /**
     * @description Rules for the /roles_admin/{adminId} collection.
     * @path /roles_admin/{adminId}
     * @allow (create) Any signed-in user can create an admin role document, but only if their UID matches the document ID.
     * @deny (create) A signed-in user cannot create an admin role document if their UID does not match the document ID.
     * @allow (get) Any signed-in user can get an admin role document, but only if their UID matches the document ID.
     * @deny (get) A signed-in user cannot get an admin role document if their UID does not match the document ID.
     * @principle Only the user with the matching UID can create or read their admin role document.
     */
    match /roles_admin/{adminId} {
      allow get: if isOwner(adminId);
      allow list: if false; // Only admins can know the other admins!
      allow create: if isOwner(adminId);
      allow update: if false;
      allow delete: if isOwner(adminId);
    }
  }
}