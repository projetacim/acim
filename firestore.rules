/**
 * @fileoverview Firestore Security Rules for the association management application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for member profiles and their associated data (donations, CERFA forms).
 * Only the authenticated user who "owns" a member profile has read and write access to it and its subcollections.
 * The `donationCategories` collection is intended to be publicly readable, but only authorized users can create/modify them.
 *
 * Data Structure:
 * - /members/{memberId}: Stores individual member profiles. 'memberId' must match the user's UID.
 * - /members/{memberId}/donations/{donationId}: Stores donations made by a specific member.
 *   Each donation includes a denormalized `memberId` field for authorization.
 * - /members/{memberId}/donations/{donationId}/cerfa/{cerfaId}: Stores CERFA forms for a specific donation.
 *   Each CERFA includes a denormalized `donationId` field for authorization.
 * - /donationCategories/{donationCategoryId}: Stores categories for donations.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Strict ownership is enforced for member profiles and all associated subcollections.
 * - Denormalization is used extensively to avoid costly `get()` calls in rules.
 * - `donationCategories` are publicly readable but only authorized users can create/modify them.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Verifies user authentication.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner of the resource.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces ownership.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is the owner of the existing resource.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the 'members' collection.
     * @path /members/{memberId}
     * @allow (create) If the authenticated user's UID matches the 'memberId'.
     * @deny (create) If the authenticated user's UID does not match the 'memberId'.
     * @principle Enforces document ownership for writes.
     */
    match /members/{memberId} {
      // Read Rules
      allow get: if isOwner(memberId);
      allow list: if false;

      // Write Rules
      allow create: if isOwner(memberId) && request.resource.data.id == memberId;
      allow update: if isExistingOwner(memberId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(memberId);
    }

    /**
     * @description Rules for the 'donations' subcollection under a member.
     * @path /members/{memberId}/donations/{donationId}
     * @allow (create) If the authenticated user owns the parent member and the 'memberId' in the donation data matches the parent 'memberId'.
     * @deny (create) If the authenticated user does not own the parent member or the 'memberId' in the donation data does not match the parent 'memberId'.
     * @principle Enforces ownership and relational integrity.
     */
    match /members/{memberId}/donations/{donationId} {
      // Read Rules
      allow get: if isOwner(memberId);
      allow list: if isOwner(memberId);

      // Write Rules
      allow create: if isOwner(memberId) && request.resource.data.memberId == memberId;
      allow update: if isExistingOwner(memberId) && resource.data.memberId == memberId && request.resource.data.memberId == resource.data.memberId;
      allow delete: if isExistingOwner(memberId);
    }

    /**
     * @description Rules for the 'cerfa' subcollection under a donation.
     * @path /members/{memberId}/donations/{donationId}/cerfa/{cerfaId}
     * @allow (create) If the authenticated user owns the parent member and the 'donationId' in the cerfa data matches the parent 'donationId'.
     * @deny (create) If the authenticated user does not own the parent member or the 'donationId' in the cerfa data does not match the parent 'donationId'.
     * @principle Enforces ownership and relational integrity.
     */
    match /members/{memberId}/donations/{donationId}/cerfa/{cerfaId} {
      // Read Rules
      allow get: if isOwner(memberId);
      allow list: if isOwner(memberId);

      // Write Rules
      allow create: if isOwner(memberId) && request.resource.data.donationId == donationId;
      allow update: if isExistingOwner(memberId) && resource.data.donationId == donationId && request.resource.data.donationId == resource.data.donationId;
      allow delete: if isExistingOwner(memberId);
    }

    /**
     * @description Rules for the 'donationCategories' collection.
     * @path /donationCategories/{donationCategoryId}
     * @allow (get, list) Public read access.
     * @deny (create, update, delete) Only allow to authenticated users.
     */
    match /donationCategories/{donationCategoryId} {
      // Read Rules
      allow get: if true;
      allow list: if true;

      // Write Rules
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}