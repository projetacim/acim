rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures the member profiles, allowing only the owner to manage their own profile.
     * @path /members/{memberId}
     * @allow (create) User with UID 'user_abc' can create a member profile with document ID 'user_abc'.
     * @allow (get, update, delete) User with UID 'user_abc' can read, update, or delete their own member profile.
     * @deny (create) User with UID 'user_xyz' cannot create a member profile with document ID 'user_abc'.
     * @deny (get, update, delete) User with UID 'user_xyz' cannot read, update, or delete the member profile of user 'user_abc'.
     * @principle Enforces document ownership for all operations.
     */
    match /members/{memberId} {
      // Helper function to check if the current user is the owner of the resource.
      function isOwner(memberId) {
        return request.auth.uid == memberId;
      }

      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the user is the owner and the resource exists
      function isExistingOwner(memberId) {
        return isOwner(memberId) && exists(/databases/$(database)/documents/members/$(memberId));
      }

      allow get: if isOwner(memberId);
      allow list: if false; // Listing members is not allowed.
      allow create: if isSignedIn() && isOwner(memberId);
      allow update: if isExistingOwner(memberId);
      allow delete: if isExistingOwner(memberId);
    }

    /**
     * @description Secures donations, allowing only the member who owns the donation to manage it.
     * @path /members/{memberId}/donations/{donationId}
     * @allow (create) User with UID 'user_abc' can create a donation under their member profile.
     * @allow (get, update, delete) User with UID 'user_abc' can read, update, or delete a donation under their member profile.
     * @deny (create) User with UID 'user_xyz' cannot create a donation under the member profile of user 'user_abc'.
     * @deny (get, update, delete) User with UID 'user_xyz' cannot read, update, or delete a donation under the member profile of user 'user_abc'.
     * @principle Enforces document ownership based on the memberId.
     */
    match /members/{memberId}/donations/{donationId} {
      // Helper function to check if the current user is the owner of the donation.
      function isDonationOwner(memberId) {
        return request.auth.uid == memberId;
      }

      function isExistingDonationOwner(memberId) {
        return isDonationOwner(memberId) && exists(/databases/$(database)/documents/members/$(memberId)/donations/$(donationId));
      }

      allow get: if isDonationOwner(memberId);
      allow list: if isDonationOwner(memberId);
      allow create: if isSignedIn() && isDonationOwner(memberId);
      allow update: if isExistingDonationOwner(memberId);
      allow delete: if isExistingDonationOwner(memberId);
    }

    /**
     * @description Secures CERFA forms, allowing only the member who owns the donation to manage its CERFA forms.
     * @path /members/{memberId}/donations/{donationId}/cerfa/{cerfaId}
     * @allow (create) User with UID 'user_abc' can create a CERFA form under their donation.
     * @allow (get, update, delete) User with UID 'user_abc' can read, update, or delete a CERFA form under their donation.
     * @deny (create) User with UID 'user_xyz' cannot create a CERFA form under the donation of user 'user_abc'.
     * @deny (get, update, delete) User with UID 'user_xyz' cannot read, update, or delete a CERFA form under the donation of user 'user_abc'.
     * @principle Enforces document ownership based on the memberId.
     */
    match /members/{memberId}/donations/{donationId}/cerfa/{cerfaId} {
      // Helper function to check if the current user is the owner of the cerfa via the memberId.
      function isCerfaOwner(memberId) {
        return request.auth.uid == memberId;
      }

      function isExistingCerfaOwner(memberId) {
        return isCerfaOwner(memberId) && exists(/databases/$(database)/documents/members/$(memberId)/donations/$(donationId)/cerfa/$(cerfaId));
      }

      allow get: if isCerfaOwner(memberId);
      allow list: if isCerfaOwner(memberId);
      allow create: if isSignedIn() && isCerfaOwner(memberId);
      allow update: if isExistingCerfaOwner(memberId);
      allow delete: if isExistingCerfaOwner(memberId);
    }

    /**
     * @description Allows public read access to donation categories, but restricts write access.
     * @path /donationCategories/{donationCategoryId}
     * @allow (get, list) Any user can read the donation categories.
     * @deny (create, update, delete) No user can create, update, or delete donation categories through the rules.
     * @principle Public read access with restricted writes.
     */
    match /donationCategories/{donationCategoryId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}