/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a user-ownership model for member profiles, donations, and transactions,
 *              and allows public read access to donation categories. It also implements an admin role based on
 *              the existence of a document in the `/roles_admin` collection.
 *
 * Data Structure:
 * - /users/{userId}/membre/{memberId}: Stores member profiles, accessible only by the owner (user).
 * - /users/{userId}/donations/{donationId}: Stores donations, accessible only by the owner (user).
 * - /users/{userId}/transactions/{transactionId}: Stores transactions, accessible only by the owner (user).
 * - /donationCategories/{categoryId}: Stores donation categories, publicly readable.
 * - /roles_admin/{adminId}: Documents indicating admin users.
 *
 * Key Security Decisions:
 * - User listing is disallowed for all collections.
 * - Admin role is determined by document existence in /roles_admin/{adminId}.
 * - Default security posture for ambiguous relationships is strict owner-only access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner of the resource.
     * @param {string} userId The user ID to compare against the request's auth UID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is the owner of the resource and the resource exists.
     *              Useful for update and delete operations.
     * @param {string} userId The user ID to compare against the request's auth UID.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
    
    /**
     * @description Checks if the current user is an admin.
     * @return {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
        return exists(/databases/(default)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for the /users/{userId}/membre/{memberId} collection.
     * @path /users/{userId}/membre/{memberId}
     * @allow (create) User 'NeMp23Bw5iZNI5GGVndOqnIZVM12' can create a member document under /users/NeMp23Bw5iZNI5GGVndOqnIZVM12/membre/someMemberId.
     * @deny (create) User 'randomUserId' cannot create a member document under /users/NeMp23Bw5iZNI5GGVndOqnIZVM12/membre/someMemberId.
     * @allow (get) User 'NeMp23Bw5iZNI5GGVndOqnIZVM12' can get a member document under /users/NeMp23Bw5iZNI5GGVndOqnIZVM12/membre/someMemberId.
     * @deny (get) User 'randomUserId' cannot get a member document under /users/NeMp23Bw5iZNI5GGVndOqnIZVM12/membre/someMemberId.
     * @principle Enforces document ownership for writes and reads within the user's data tree.
     */
    match /users/{userId}/membre/{memberId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == memberId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /users/{userId}/donations/{donationId} collection.
     * @path /users/{userId}/donations/{donationId}
     * @allow (create) User 'NeMp23Bw5iZNI5GGVndOqnIZVM12' can create a donation document under /users/NeMp23Bw5iZNI5GGVndOqnIZVM12/donations/someDonationId.
     * @deny (create) User 'randomUserId' cannot create a donation document under /users/NeMp23Bw5iZNI5GGVndOqnIZVM12/donations/someDonationId.
     * @allow (get) User 'NeMp23Bw5iZNI5GGVndOqnIZVM12' can get a donation document under /users/NeMp23Bw5iZNI5GGVndOqnIZVM12/donations/someDonationId.
     * @deny (get) User 'randomUserId' cannot get a donation document under /users/NeMp23Bw5iZNI5GGVndOqnIZVM12/donations/someDonationId.
     * @allow (update) User 'NeMp23Bw5iZNI5GGVndOqnIZVM12' can update a donation document under /users/NeMp23Bw5iZNI5GGVndOqnIZVM12/donations/someDonationId.
     * @deny (update) User 'randomUserId' cannot update a donation document under /users/NeMp23Bw5iZNI5GGVndOqnIZVM12/donations/someDonationId.
     * @principle Enforces document ownership for writes and reads within the user's data tree.
     */
    match /users/{userId}/donations/{donationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == donationId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /users/{userId}/transactions/{transactionId} collection.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (create) User 'NeMp23Bw5iZNI5GGVndOqnIZVM12' can create a transaction document under /users/NeMp23Bw5iZNI5GGVndOqnIZVM12/transactions/someTransactionId.
     * @deny (create) User 'randomUserId' cannot create a transaction document under /users/NeMp23Bw5iZNI5GGVndOqnIZVM12/transactions/someTransactionId.
     * @allow (get) User 'NeMp23Bw5iZNI5GGVndOqnIZVM12' can get a transaction document under /users/NeMp23Bw5iZNI5GGVndOqnIZVM12/transactions/someTransactionId.
     * @deny (get) User 'randomUserId' cannot get a transaction document under /users/NeMp23Bw5iZNI5GGVndOqnIZVM12/transactions/someTransactionId.
     * @principle Enforces document ownership for writes and reads within the user's data tree.
     */
    match /users/{userId}/transactions/{transactionId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == transactionId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /donationCategories/{categoryId} collection.
     * @path /donationCategories/{categoryId}
     * @allow (get) Any user can read donation categories.
     * @allow (list) Any user can list donation categories.
     * @deny (create) No one can create donation categories through the client.
     * @principle Allows public read access to donation categories.
     */
    match /donationCategories/{categoryId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for the /roles_admin/{adminId} collection.
     * @path /roles_admin/{adminId}
     * @allow (get) Any user can read admin profiles.
     * @allow (list) Any user can list admin profiles.
     * @deny (create) No one can create admin profiles through the client, only throught back-end.
     */
    match /roles_admin/{adminId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}