/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based security model with public read access for some collections.
 *
 * Data Structure:
 * - /users/{userId}/...: Data nested under a user ID is strictly owned by that user.
 * - /donationCategories/{categoryId}: Public read access, but only admins can modify.
 * - /roles_admin/{adminId}: Defines admin roles; presence grants database-wide access.
 *
 * Key Security Decisions:
 * - User-specific data (members, donations, transactions) is only accessible to the owning user.
 * - Donation categories are publicly readable but only modifiable by admins.
 * - Admin status is determined by the presence of a document in the `/roles_admin` collection with the user's UID as the document ID. This avoids needing to store admin roles directly within user documents.
 * - Listing of user documents is allowed only for the user themselves.
 *
 * Denormalization for Authorization:
 * - Admin status is checked by verifying the existence of a document in the `/roles_admin` collection with the user's UID as the document ID. This avoids needing to store admin roles directly within user documents.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isExistingOwner(userId) {
      return (isOwner(userId) && resource.data != null);
    }

    /**
     * @description Grants access to a user's member profile to the user and administrators only.
     * @path /users/{userId}/membre/{memberId}
     * @allow (get, list) User with UID 'userId' can read their own member profile.
     * @deny (get, list) User with UID different from 'userId' cannot read this member profile.
     * @allow (create, update, delete) User with UID 'userId' can create, update, and delete their own member profile.
     * @deny (create, update, delete) User with UID different from 'userId' cannot modify this member profile.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/membre/{memberId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to a user's donation records to the user and administrators only.
     * @path /users/{userId}/donations/{donationId}
     * @allow (get, list) User with UID 'userId' can read their own donations.
     * @deny (get, list) User with UID different from 'userId' cannot read these donations.
     * @allow (create, update, delete) User with UID 'userId' can create, update, and delete their own donations.
     * @deny (create, update, delete) User with UID different from 'userId' cannot modify these donations.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/donations/{donationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to a user's financial transactions to the user and administrators only.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (get, list) User with UID 'userId' can read their own transactions.
     * @deny (get, list) User with UID different from 'userId' cannot read these transactions.
     * @allow (create, update, delete) User with UID 'userId' can create, update, and delete their own transactions.
     * @deny (create, update, delete) User with UID different from 'userId' cannot modify these transactions.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/transactions/{transactionId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants public read access to donation categories, but restricts modification to admins only.
     * @path /donationCategories/{categoryId}
     * @allow (get, list) Any user can read donation categories.
     * @allow (create, update, delete) Only admins can create, update, or delete donation categories.
     * @deny (create, update, delete) Non-admin users cannot modify donation categories.
     * @principle Allows public read access while enforcing admin-only writes.
     */
    match /donationCategories/{categoryId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

     /**
      * @description Allows only authenticated admins to read admin profiles
      * @path /roles_admin/{adminId}
      * @allow get: If the user is an admin, they can perform a get request
      * @allow list: If the user is an admin, they can perform a list request
      *
      * @allow create: if false;
      * @allow update: if false;
      * @allow delete: if false;
      */
    match /roles_admin/{adminId} {
        allow get: if isAdmin() && request.auth.uid == adminId;
        allow list: if isAdmin();
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }
  }
}