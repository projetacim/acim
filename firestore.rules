/**
 * @file Overview
 * This ruleset enforces a strict user-ownership model for member profiles, donations, and CERFA forms,
 * ensuring that only authenticated users can access and modify their own data. Donation categories are publicly readable.
 *
 * @dataStructure
 * - /members/{memberId}: Stores member profiles, accessible only to the member themselves.
 * - /members/{memberId}/donations/{donationId}: Stores donations made by a member, accessible only to that member.
 * - /members/{memberId}/donations/{donationId}/cerfa/{cerfaId}: Stores CERFA forms for a donation, accessible only to the member who made the donation.
 * - /donationCategories/{donationCategoryId}: Stores donation categories, publicly readable.
 *
 * @keySecurityDecisions
 * - User listing is disallowed.
 * - Data required for authorization is denormalized onto the documents themselves to avoid costly `get()` calls.
 * - Default security posture for ambiguous relationships is strict owner-only access.
 *
 * @denormalizationForAuthorization
 * - Donations store the `memberId` to allow direct authorization checks without needing to fetch the parent member document.
 * - CERFA documents store the `donationId` to allow direct authorization checks without needing to fetch the parent donation document.
 *
 * @structuralSegregation
 * - Members, donations, CERFA forms, and donation categories are stored in separate collections to simplify security rules and optimize query performance.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner and the resource exists.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
    
    /**
     * @description Enforces document ownership for members.
     * @path /members/{memberId}
     * @allow (create) - User with UID 'user123' can create a member document with ID 'user123'.
     * @allow (get, list) - User with UID 'user123' can read their own member document.
     * @allow (update, delete) - User with UID 'user123' can update/delete their own member document.
     * @deny (create) - User with UID 'user456' cannot create a member document with ID 'user123'.
     * @deny (get, list) - User with UID 'user456' cannot read member document with ID 'user123'.
     * @deny (update, delete) - User with UID 'user456' cannot update/delete member document with ID 'user123'.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /members/{memberId} {
      allow get, list: if isOwner(memberId);
      allow create: if isOwner(memberId) && request.resource.data.id == memberId;
      allow update, delete: if isExistingOwner(memberId) && request.resource.data.id == resource.data.id;
    }

    /**
     * @description Enforces document ownership for donations within a member's profile.
     * @path /members/{memberId}/donations/{donationId}
     * @allow (create) - User with UID 'user123' can create a donation document under /members/user123/donations/.
     * @allow (get, list) - User with UID 'user123' can read their own donation documents under /members/user123/donations/.
     * @allow (update, delete) - User with UID 'user123' can update/delete their own donation documents under /members/user123/donations/.
     * @deny (create) - User with UID 'user456' cannot create a donation document under /members/user123/donations/.
     * @deny (get, list) - User with UID 'user456' cannot read donation documents under /members/user123/donations/.
     * @deny (update, delete) - User with UID 'user456' cannot update/delete donation documents under /members/user123/donations/.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /members/{memberId}/donations/{donationId} {
      allow get, list: if isOwner(memberId);
      allow create: if isOwner(memberId) && request.resource.data.memberId == memberId;
      allow update, delete: if isExistingOwner(memberId) && request.resource.data.memberId == resource.data.memberId;
    }

    /**
     * @description Enforces document ownership for CERFA forms within a donation.
     * @path /members/{memberId}/donations/{donationId}/cerfa/{cerfaId}
     * @allow (create) - User with UID 'user123' can create a cerfa document under /members/user123/donations/{donationId}/cerfa/.
     * @allow (get, list) - User with UID 'user123' can read their own cerfa documents under /members/user123/donations/{donationId}/cerfa/.
     * @allow (update, delete) - User with UID 'user123' can update/delete their own cerfa documents under /members/user123/donations/{donationId}/cerfa/.
     * @deny (create) - User with UID 'user456' cannot create a cerfa document under /members/user123/donations/{donationId}/cerfa/.
     * @deny (get, list) - User with UID 'user456' cannot read cerfa documents under /members/user123/donations/{donationId}/cerfa/.
     * @deny (update, delete) - User with UID 'user456' cannot update/delete cerfa documents under /members/user123/donations/{donationId}/cerfa/.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /members/{memberId}/donations/{donationId}/cerfa/{cerfaId} {
      allow get, list: if isOwner(memberId);
      allow create: if isOwner(memberId) && request.resource.data.donationId == donationId;
      allow update, delete: if isExistingOwner(memberId) && request.resource.data.donationId == resource.data.donationId;
    }

    /**
     * @description Allows public read access to donation categories, with no write access.
     * @path /donationCategories/{donationCategoryId}
     * @allow (get, list) - Any user (signed in or not) can read donation category documents.
     * @deny (create, update, delete) - No user can create, update, or delete donation category documents.
     * @principle Provides public read access while restricting write access.
     */
    match /donationCategories/{donationCategoryId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}