rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces that only authenticated users can manage their own member profile.
     * @path /databases/{database}/documents/members/{memberId}
     * @allow (create) User with UID 'user123' can create their profile at /members/user123.
     * @allow (get) User with UID 'user123' can read their profile at /members/user123.
     * @allow (update) User with UID 'user123' can update their profile at /members/user123.
     * @allow (delete) User with UID 'user123' can delete their profile at /members/user123.
     * @deny (create) User with UID 'user123' cannot create a profile at /members/user456.
     * @deny (get) User with UID 'user123' cannot read the profile at /members/user456.
     * @deny (update) User with UID 'user123' cannot update the profile at /members/user456.
     * @deny (delete) User with UID 'user123' cannot delete the profile at /members/user456.
     * @principle Enforces document ownership for writes.
     */
    match /members/{memberId} {
      // Utility function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Utility function to check if the authenticated user is the owner of the document
      function isOwner(memberId) {
        return request.auth.uid == memberId;
      }

      // Utility function to check if the authenticated user is the owner of an existing document
      function isExistingOwner(memberId) {
        return isOwner(memberId) && resource != null;
      }

      allow get: if isOwner(memberId);
      allow list: if false; // Disallowing listing all users for privacy

      allow create: if isSignedIn() && isOwner(memberId);
      allow update: if isExistingOwner(memberId);
      allow delete: if isExistingOwner(memberId);
    }

    /**
     * @description Enforces that only the owner of a member profile can manage the member's donations.
     * @path /databases/{database}/documents/members/{memberId}/donations/{donationId}
     * @allow (create) User with UID 'user123' can create a donation under their profile at /members/user123/donations/donation1.
     * @allow (get) User with UID 'user123' can read a donation under their profile at /members/user123/donations/donation1.
     * @allow (update) User with UID 'user123' can update a donation under their profile at /members/user123/donations/donation1.
     * @allow (delete) User with UID 'user123' can delete a donation under their profile at /members/user123/donations/donation1.
     * @deny (create) User with UID 'user456' cannot create a donation under the profile of user with UID 'user123' at /members/user123/donations/donation1.
     * @deny (get) User with UID 'user456' cannot read a donation under the profile of user with UID 'user123' at /members/user123/donations/donation1.
     * @deny (update) User with UID 'user456' cannot update a donation under the profile of user with UID 'user123' at /members/user123/donations/donation1.
     * @deny (delete) User with UID 'user456' cannot delete a donation under the profile of user with UID 'user123' at /members/user123/donations/donation1.
     * @principle Restricts access to a user's own data tree.
     */
    match /members/{memberId}/donations/{donationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(memberId) {
        return request.auth.uid == memberId;
      }

      function isExistingOwner(memberId) {
        return isOwner(memberId) && resource != null;
      }

      allow get: if isOwner(memberId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(memberId);
      allow update: if isExistingOwner(memberId);
      allow delete: if isExistingOwner(memberId);
    }

    /**
     * @description Enforces that only the owner of a donation can manage CERFA forms associated with the donation.
     * @path /databases/{database}/documents/members/{memberId}/donations/{donationId}/cerfa/{cerfaId}
     * @allow (create) User with UID 'user123' can create a CERFA form under their donation at /members/user123/donations/donation1/cerfa/cerfa1.
     * @allow (get) User with UID 'user123' can read a CERFA form under their donation at /members/user123/donations/donation1/cerfa/cerfa1.
     * @allow (update) User with UID 'user123' can update a CERFA form under their donation at /members/user123/donations/donation1/cerfa/cerfa1.
     * @allow (delete) User with UID 'user123' can delete a CERFA form under their donation at /members/user123/donations/donation1/cerfa/cerfa1.
     * @deny (create) User with UID 'user456' cannot create a CERFA form under the donation of user with UID 'user123' at /members/user123/donations/donation1/cerfa/cerfa1.
     * @deny (get) User with UID 'user456' cannot read a CERFA form under the donation of user with UID 'user123' at /members/user123/donations/donation1/cerfa/cerfa1.
     * @deny (update) User with UID 'user456' cannot update a CERFA form under the donation of user with UID 'user123' at /members/user123/donations/donation1/cerfa/cerfa1.
     * @deny (delete) User with UID 'user456' cannot delete a CERFA form under the donation of user with UID 'user123' at /members/user123/donations/donation1/cerfa/cerfa1.
     * @principle Enforces that only the owner can manage nested data.
     */
    match /members/{memberId}/donations/{donationId}/cerfa/{cerfaId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(memberId) {
        return request.auth.uid == memberId;
      }

      function isExistingOwner(memberId) {
        return isOwner(memberId) && resource != null;
      }

      allow get: if isOwner(memberId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(memberId);
      allow update: if isExistingOwner(memberId);
      allow delete: if isExistingOwner(memberId);
    }

    /**
     * @description Allows public read access to donation categories.
     * @path /databases/{database}/documents/donationCategories/{donationCategoryId}
     * @allow (get) Any user can read a donation category.
     * @allow (list) Any user can list donation categories.
     * @deny (create) No user can create a donation category (admin only). // TODO: Add admin role to allow category creation.
     * @deny (update) No user can update a donation category (admin only). // TODO: Add admin role to allow category update.
     * @deny (delete) No user can delete a donation category (admin only). // TODO: Add admin role to allow category deletion.
     * @principle Allows public read access with restricted write access.
     */
    match /donationCategories/{donationCategoryId} {
      allow get: if true;
      allow list: if true;

      allow create: if false; // TODO: Add admin role validation
      allow update: if false; // TODO: Add admin role validation
      allow delete: if false; // TODO: Add admin role validation
    }
  }
}