/**
 * @file Overview
 * This ruleset enforces a strict user-ownership model for member profiles, donations, and CERFA forms,
 * ensuring that only authenticated users can access and modify their own data. Donation categories are 
 * intended to be publicly readable but only modifiable by authenticated users.
 *
 * @dataStructure
 * - /members/{memberId}: Stores member profiles, accessible only by the member themselves.
 * - /members/{memberId}/donations/{donationId}: Stores donations made by a member, accessible only by that member.
 * - /members/{memberId}/donations/{donationId}/cerfa/{cerfaId}: Stores CERFA forms for a donation, accessible only by the member who made the donation.
 * - /donationCategories/{donationCategoryId}: Stores donation categories, publicly readable but writable only by authenticated users.
 *
 * @keySecurityDecisions
 * - User listing is disallowed to protect privacy.
 * - Strict ownership is enforced for all member-related data (profiles, donations, CERFA forms).
 * - The `donationCategories` collection allows public read access but requires authentication for write access.
 * - Data types and required fields are NOT validated in this prototyping phase.
 *
 * @denormalizationForAuthorization
 * - The `memberId` is stored within each Donation document to allow direct association with the member and independent access
 *   without needing to traverse the parent member document.
 * - The `donationId` is stored within each Cerfa document to allow direct association with the donation and independent access.
 *
 * @structuralSegregation
 * - Member profiles, donations, and CERFA forms are stored in separate collections to enforce distinct security requirements.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to member profiles. Only the member themselves can read or write their profile.
     * @path /members/{memberId}
     * @allow (create) User with UID 'user123' can create their profile if request.auth.uid == 'user123'.
     * @allow (get,update,delete) User with UID 'user123' can read/update/delete their profile at /members/user123.
     * @deny (create) User with UID 'user456' cannot create a profile with ID 'user123'.
     * @deny (get,update,delete) User with UID 'user456' cannot read/update/delete the profile at /members/user123.
     * @principle Enforces document ownership for writes.
     */
    match /members/{memberId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(memberId);
      allow list: if false;
      allow create: if isOwner(memberId);
      allow update: if isExistingOwner(memberId);
      allow delete: if isExistingOwner(memberId);
    }

    /**
     * @description Controls access to donations made by a member. Only the member themselves can manage their donations.
     * @path /members/{memberId}/donations/{donationId}
     * @allow (create) User with UID 'user123' can create a donation under /members/user123/donations/donation456.
     * @allow (get,update,delete) User with UID 'user123' can read/update/delete their donation at /members/user123/donations/donation456.
     * @deny (create) User with UID 'user456' cannot create a donation under /members/user123/donations/donation456.
     * @deny (get,update,delete) User with UID 'user456' cannot read/update/delete the donation at /members/user123/donations/donation456.
     * @principle Restricts access to a user's own data tree.
     */
    match /members/{memberId}/donations/{donationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(memberId);
      allow list: if isOwner(memberId);
      allow create: if isOwner(memberId);
      allow update: if isExistingOwner(memberId);
      allow delete: if isExistingOwner(memberId);
    }

    /**
     * @description Controls access to CERFA forms associated with a donation. Only the member who made the donation can manage the CERFA forms.
     * @path /members/{memberId}/donations/{donationId}/cerfa/{cerfaId}
     * @allow (create) User with UID 'user123' can create a CERFA form under /members/user123/donations/donation456/cerfa/cerfa789.
     * @allow (get,update,delete) User with UID 'user123' can read/update/delete their CERFA form at /members/user123/donations/donation456/cerfa/cerfa789.
     * @deny (create) User with UID 'user456' cannot create a CERFA form under /members/user123/donations/donation456/cerfa/cerfa789.
     * @deny (get,update,delete) User with UID 'user456' cannot read/update/delete the CERFA form at /members/user123/donations/donation456/cerfa/cerfa789.
     * @principle Restricts access to a user's own data tree.
     */
    match /members/{memberId}/donations/{donationId}/cerfa/{cerfaId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(memberId);
      allow list: if isOwner(memberId);
      allow create: if isOwner(memberId);
      allow update: if isExistingOwner(memberId);
      allow delete: if isExistingOwner(memberId);
    }

    /**
     * @description Controls access to donation categories. Allows public read access but restricts write access to authenticated users.
     * @path /donationCategories/{donationCategoryId}
     * @allow (get, list) Any user (signed in or not) can read the donation categories.
     * @allow (create, update, delete) Only authenticated users can create, update, or delete donation categories.
     * @deny (create, update, delete) Anonymous users cannot create, update, or delete donation categories.
     * @principle Allows public read access with authenticated-user-only writes.
     */
    match /donationCategories/{donationCategoryId} {
        function isSignedIn() {
            return request.auth != null;
        }
        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn();
        allow update: if isSignedIn() && resource != null;
        allow delete: if isSignedIn() && resource != null;
    }
  }
}