/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a tiered security model:
 *   - User-owned data: Members, Donations, and Transactions are stored under /users/{userId} and are only accessible to that user.
 *   - Global Donation Categories: Donation categories are globally readable but only writable by admins.
 *   - Admin Roles: Admin privileges are granted based on the existence of a document in the `/roles_admin/{adminId}` collection.
 *
 * Data Structure:
 *   - /users/{userId}/membre/{memberId}: Member profiles, accessible only to the owning user.
 *   - /users/{userId}/donations/{donationId}: Donation records, accessible only to the owning user.
 *   - /users/{userId}/transactions/{transactionId}: Transaction history, accessible only to the owning user.
 *   - /donationCategories/{categoryId}: Publicly readable categories for donations, writable only by admins.
 *   - /roles_admin/{adminId}: Admin user list; presence grants admin role.
 *
 * Key Security Decisions:
 *   - User data is strictly segregated and only accessible to the owning user.
 *   - Donation categories are globally readable but only admin-modifiable.
 *   - Admin status is determined by document existence in `/roles_admin`.
 *   - Listing of documents is generally allowed for user-owned subcollections.
 *
 * Denormalization for Authorization:
 *   - Admin status is checked via `exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))`, avoiding the need to read the user's document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the resource.
     * @param {string} userId - The user ID to check against.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an existing owner of the resource.
     * @param {string} userId - The user ID to check against.
     * @return {bool} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is an admin.
     * @return {bool} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for member profiles under a user.
     * @path /users/{userId}/membre/{memberId}
     * @allow (create) User 'NeMp23Bw5iZNI5GGVndOqnIZVM12' can create a member profile under their own user ID.
     * @deny (create) User 'OtherUserId' cannot create a member profile under user ID 'NeMp23Bw5iZNI5GGVndOqnIZVM12'.
     * @allow (get) User 'NeMp23Bw5iZNI5GGVndOqnIZVM12' can get a member profile under their own user ID.
     * @deny (get) User 'OtherUserId' cannot get a member profile under user ID 'NeMp23Bw5iZNI5GGVndOqnIZVM12'.
     * @principle Enforces document ownership for writes. Restricts access to a user's own data tree. Validates relational integrity between documents.
     */
    match /users/{userId}/membre/{memberId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == memberId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for donations under a user.
     * @path /users/{userId}/donations/{donationId}
     * @allow (create) User 'NeMp23Bw5iZNI5GGVndOqnIZVM12' can create a donation under their own user ID.
     * @deny (create) User 'OtherUserId' cannot create a donation under user ID 'NeMp23Bw5iZNI5GGVndOqnIZVM12'.
     * @allow (get) User 'NeMp23Bw5iZNI5GGVndOqnIZVM12' can get a donation under their own user ID.
     * @deny (get) User 'OtherUserId' cannot get a donation under user ID 'NeMp23Bw5iZNI5GGVndOqnIZVM12'.
     * @principle Enforces document ownership for writes. Restricts access to a user's own data tree. Validates relational integrity between documents.
     */
    match /users/{userId}/donations/{donationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.memberId != null;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for transactions under a user.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (create) User 'NeMp23Bw5iZNI5GGVndOqnIZVM12' can create a transaction under their own user ID.
     * @deny (create) User 'OtherUserId' cannot create a transaction under user ID 'NeMp23Bw5iZNI5GGVndOqnIZVM12'.
     * @allow (get) User 'NeMp23Bw5iZNI5GGVndOqnIZVM12' can get a transaction under their own user ID.
     * @deny (get) User 'OtherUserId' cannot get a transaction under user ID 'NeMp23Bw5iZNI5GGVndOqnIZVM12'.
     * @principle Enforces document ownership for writes. Restricts access to a user's own data tree. Validates relational integrity between documents.
     */
    match /users/{userId}/transactions/{transactionId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for global donation categories.
     * @path /donationCategories/{categoryId}
     * @allow (get) Any user can read donation categories.
     * @allow (list) Any user can list donation categories.
     * @deny (create) Non-admin user cannot create donation categories.
     * @allow (create) Admin user can create donation categories.
     * @principle Public read with admin-only writes.
     */
    match /donationCategories/{categoryId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for admin roles.
     * @path /roles_admin/{adminId}
     * @allow (get) Any user can check for the existance of an admin role.
     * @deny (create) Non-admin user cannot create admin roles.
     * @allow (create) Admin user can create admin roles.
     * @principle Restricts admin role creation to existing admins.
     */
    match /roles_admin/{adminId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin() && resource != null;
    }
  }
}