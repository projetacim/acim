/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for member profiles, donations, and transactions,
 * where each user can only access data they own. Donation categories are publicly readable,
 * but only admins can manage them. Admin privileges are granted by the existence of a document
 * in the `roles_admin` collection.
 *
 * Data Structure:
 * - `/users/{userId}/membre/{memberId}`: Member profiles, owned by the user with ID `userId`.
 * - `/users/{userId}/donations/{donationId}`: Donations made by the user with ID `userId`.
 * - `/users/{userId}/transactions/{transactionId}`: Transactions associated with the user with ID `userId`.
 * - `/donationCategories/{categoryId}`: Global categories for donations, publicly readable.
 * - `/roles_admin/{adminId}`: Collection of admin users. If a document exists for a user, that user is an admin.
 *
 * Key Security Decisions:
 * - Users can only list documents in their own subcollections.
 * - Listing of `donationCategories` is allowed for all users.
 * - Only authenticated users can access any data.
 *
 * Denormalization for Authorization:
 *  -  The current data model does not have an ownership field on the /donationCategories/{categoryId} documents.
 *     Admin privileges are determined by the existence of a document in the `roles_admin` collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by an authenticated user.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     * @param {string} userId The user ID to compare against the request's auth UID.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is an existing owner of the resource.
     * @param {string} userId The user ID to compare against the request's auth UID.
     * @return {bool} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the authenticated user is an admin.
     * @return {bool} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return exists(/databases/(default)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description
     * Rules for the /users/{userId}/membre/{memberId} collection.
     * Enforces that only the owner (the user with the matching userId) can read, create, update, or delete member profiles.
     * @path /users/{userId}/membre/{memberId}
     * @allow (create) - User `NeMp23Bw5iZNI5GGVndOqnIZVM12` can create a member profile with `userId` and `memberId` matching their UID.
     * @allow (get) - User `NeMp23Bw5iZNI5GGVndOqnIZVM12` can get a member profile where `userId` and `memberId` match their UID.
     * @allow (update) - User `NeMp23Bw5iZNI5GGVndOqnIZVM12` can update a member profile where `userId` and `memberId` match their UID.
     * @allow (delete) - User `NeMp23Bw5iZNI5GGVndOqnIZVM12` can delete a member profile where `userId` and `memberId` match their UID.
     * @deny (create) - User `SomeOtherUserId` cannot create a member profile under /users/NeMp23Bw5iZNI5GGVndOqnIZVM12/membre/SomeMemberId.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/membre/{memberId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == memberId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description
     * Rules for the /users/{userId}/donations/{donationId} collection.
     * Enforces that only the owner (the user with the matching userId) can read, create, update, or delete donations.
     * @path /users/{userId}/donations/{donationId}
     * @allow (create) - User `NeMp23Bw5iZNI5GGVndOqnIZVM12` can create a donation with `userId` matching their UID.
     * @allow (get) - User `NeMp23Bw5iZNI5GGVndOqnIZVM12` can get a donation where `userId` matches their UID.
     * @allow (update) - User `NeMp23Bw5iZNI5GGVndOqnIZVM12` can update a donation where `userId` matches their UID.
     * @allow (delete) - User `NeMp23Bw5iZNI5GGVndOqnIZVM12` can delete a donation where `userId` matches their UID.
     * @deny (create) - User `SomeOtherUserId` cannot create a donation under /users/NeMp23Bw5iZNI5GGVndOqnIZVM12/donations/SomeDonationId.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/donations/{donationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == donationId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description
     * Rules for the /users/{userId}/transactions/{transactionId} collection.
     * Enforces that only the owner (the user with the matching userId) can read, create, update, or delete transactions.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (create) - User `NeMp23Bw5iZNI5GGVndOqnIZVM12` can create a transaction with `userId` matching their UID.
     * @allow (get) - User `NeMp23Bw5iZNI5GGVndOqnIZVM12` can get a transaction where `userId` matches their UID.
     * @allow (update) - User `NeMp23Bw5iZNI5GGVndOqnIZVM12` can update a transaction where `userId` matches their UID.
     * @allow (delete) - User `NeMp23Bw5iZNI5GGVndOqnIZVM12` can delete a transaction where `userId` matches their UID.
     * @deny (create) - User `SomeOtherUserId` cannot create a transaction under /users/NeMp23Bw5iZNI5GGVndOqnIZVM12/transactions/SomeTransactionId.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/transactions/{transactionId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == transactionId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description
     * Rules for the /donationCategories/{categoryId} collection.
     * Allows anyone to read donation categories, but only admins can create, update, or delete them.
     * @path /donationCategories/{categoryId}
     * @allow (get, list) - Any user, signed in or not, can read donation categories.
     * @allow (create, update, delete) - Only admins can create, update, or delete donation categories.
     * @deny (create) - A non-admin user cannot create a donation category.
     * @principle Public read access with admin-only writes.
     */
    match /donationCategories/{categoryId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description
     * Rules for the /roles_admin/{adminId} collection.
     * Only admins can create other admins.
     * Any authenticated user can read their own admin document to check for admin privileges.
     * No listing allowed.
     * @path /roles_admin/{adminId}
     */
    match /roles_admin/{adminId} {
        allow get: if isSignedIn() && request.auth.uid == adminId;
        allow list: if false;
        allow create: if isAdmin();
        allow update: if false;
        allow delete: if false;
    }
  }
}