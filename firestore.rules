/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for most data, with admin override capabilities where specified.
 * Users can only read and write data under their own user ID, preventing unauthorized access to other users' data.
 *
 * Data Structure:
 * Data is organized under user-specific paths (e.g., `/users/{userId}/donations/{donationId}`).
 * A separate `/roles_admin/{adminId}` collection is used to store admin user roles.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Admin roles are managed through the `/roles_admin` collection.
 * - Default security posture for ambiguous relationships is strict owner-only access.
 *
 * Denormalization for Authorization:
 * The rules rely on the authenticated user's UID (`request.auth.uid`) to match the `userId` in the data path.
 * This avoids costly `get()` operations to check user identity.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     * @param {string} userId The user ID to compare against the authenticated user's UID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

        /**
     * @description Checks if the authenticated user is the owner of the existing resource.
     * @param {string} userId The user ID to compare against the authenticated user's UID.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is an admin.
     * @return {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    match /users/{userId}/membre/{memberId} {
      /**
       * @description Manages member profiles under the user who created them.
       * @path /users/{userId}/membre/{memberId}
       * @allow (create) Authenticated user with matching userId creates a new member profile.
       * @allow (get) Authenticated user with matching userId retrieves their member profile.
       * @allow (update) Authenticated user with matching userId updates their existing member profile.
       * @allow (delete) Authenticated user with matching userId deletes their member profile.
       * @deny (create) Authenticated user attempts to create a member profile under a different userId.
       * @principle Enforces document ownership for writes; only the owner can modify or delete.
       */
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == memberId;
      allow update: if isExistingOwner(userId) && resource.data.id == request.resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    match /users/{userId}/donations/{donationId} {
      /**
       * @description Manages donations made by users.
       * @path /users/{userId}/donations/{donationId}
       * @allow (create) Authenticated user with matching userId creates a new donation.
       * @allow (get) Authenticated user with matching userId retrieves their donation.
       * @allow (update) Authenticated user with matching userId updates their existing donation.
       * @allow (delete) Authenticated user with matching userId deletes their donation.
       * @deny (create) Authenticated user attempts to create a donation under a different userId.
       * @principle Enforces document ownership for writes; only the owner can modify or delete.
       */
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == donationId;
      allow update: if isExistingOwner(userId) && resource.data.id == request.resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

     match /users/{userId}/transactions/{transactionId} {
      /**
       * @description Manages financial transactions of users.
       * @path /users/{userId}/transactions/{transactionId}
       * @allow (create) Authenticated user with matching userId creates a new transaction.
       * @allow (get) Authenticated user with matching userId retrieves their transaction.
       * @allow (update) Authenticated user with matching userId updates their existing transaction.
       * @allow (delete) Authenticated user with matching userId deletes their transaction.
       * @deny (create) Authenticated user attempts to create a transaction under a different userId.
       * @principle Enforces document ownership for writes; only the owner can modify or delete.
       */
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == transactionId;
      allow update: if isExistingOwner(userId) && resource.data.id == request.resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    match /users/{userId}/donationCategories/{categoryId} {
      /**
       * @description Manages donation categories specific to each user.
       * @path /users/{userId}/donationCategories/{categoryId}
       * @allow (create) Authenticated user with matching userId creates a new donation category.
       * @allow (get) Authenticated user with matching userId retrieves their donation category.
       * @allow (update) Authenticated user with matching userId updates their existing donation category.
       * @allow (delete) Authenticated user with matching userId deletes their donation category.
       * @deny (create) Authenticated user attempts to create a donation category under a different userId.
       * @principle Enforces document ownership for writes; only the owner can modify or delete.
       */
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == categoryId;
      allow update: if isExistingOwner(userId) && resource.data.id == request.resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

     match /roles_admin/{adminId} {
      /**
       * @description Manages admin user roles. Existence of a document with a specific UID grants admin privileges.
       * @path /roles_admin/{adminId}
       */
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}