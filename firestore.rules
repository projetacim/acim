/**
 * @fileOverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-generated content
 * (members, donations, transactions).  Admins, identified by documents in the
 * `/roles_admin` collection, have read access to all data.
 *
 * Data Structure:
 * - `/users/{userId}/membre/{memberId}`: Member profiles, owned by the user.
 * - `/users/{userId}/donations/{donationId}`: Donations made by the user.
 * - `/users/{userId}/transactions/{transactionId}`: Transactions related to a user.
 * - `/donationCategories/{categoryId}`: Public donation categories.
 * - `/roles_admin/{adminId}`: Admin user profiles; existence grants admin privileges.
 *
 * Key Security Decisions:
 * - Listing of users is disallowed.
 * - Admin status is determined by the existence of a document in `/roles_admin/{userId}`.
 * - Read-only collections (e.g., `/donationCategories`) are publicly readable.
 * - Data validation is minimal for prototyping but enforces relational integrity
 *   (e.g., memberId in /users/{userId}/donations/{donationId} must match {memberId} in /users/{userId}/membre/{memberId}).
 *
 * Denormalization for Authorization:
 * - Admin status is checked directly via `exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))`,
 *   avoiding the need for a separate "admins" collection lookup in most rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the resource.
     * @param {string} userId The user ID to check against.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an existing owner of the resource.
     * @param {string} userId The user ID to check against.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && exists(resource.data);
    }

     /**
      * @description Checks if the user is an admin.
      * @return {boolean} True if the user is an admin, false otherwise.
      */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for the /users/{userId}/membre/{memberId} collection.
     * @path /users/{userId}/membre/{memberId}
     * @allow (create) - Authenticated user can create a member profile for themselves, and the memberId matches the authenticated user's ID.
     * @deny (create) - Unauthenticated user cannot create a member profile.
     * @allow (get) - Owner can get their member.
     * @deny (get) - Non-owner cannot get this member.
     * @allow (list) - Owner can list members.
     * @deny (list) - Non-owner cannot list members.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/membre/{memberId} {
      // Read rules
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();

      // Write rules
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for the /users/{userId}/donations/{donationId} collection.
     * @path /users/{userId}/donations/{donationId}
     * @allow (create) - Authenticated user can create a donation under their user ID.
     * @deny (create) - Unauthenticated user cannot create a donation.
     * @allow (get) - Owner can get their donation.
     * @deny (get) - Non-owner cannot get this donation.
     * @allow (list) - Owner can list donations.
     * @deny (list) - Non-owner cannot list donations.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/donations/{donationId} {
      // Read rules
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();

      // Write rules
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for the /users/{userId}/transactions/{transactionId} collection.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (create) - Authenticated user can create a transaction under their user ID.
     * @deny (create) - Unauthenticated user cannot create a transaction.
     * @allow (get) - Owner can get their transaction.
     * @deny (get) - Non-owner cannot get this transaction.
     * @allow (list) - Owner can list transactions.
     * @deny (list) - Non-owner cannot list transactions.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/transactions/{transactionId} {
      // Read rules
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();

      // Write rules
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for the /donationCategories/{categoryId} collection.
     * @path /donationCategories/{categoryId}
     * @allow (get) - Any user can read donation categories.
     * @allow (list) - Any user can list donation categories.
     * @deny (create) - No one can create donation categories.
     * @deny (update) - No one can update donation categories.
     * @deny (delete) - No one can delete donation categories.
     * @principle Allows public read access to donation categories, restricts write access.
     */
    match /donationCategories/{categoryId} {
      // Read rules
      allow get: if true;
      allow list: if true;

      // Write rules - Only admin allowed
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for the /roles_admin/{adminId} collection.
     * @path /roles_admin/{adminId}
     * @allow (get) - Anyone can get admin roles.
     * @allow (list) - No one can list admin roles.
     * @allow (create) - Only the user with matching adminId can create an admin role.
     * @deny (update) - No one can update admin roles.
     * @deny (delete) - No one can delete admin roles.
     */
    match /roles_admin/{adminId} {
      // Read rules
      allow get: if true;
      allow list: if false;

      // Write rules
      allow create: if isSignedIn() && request.auth.uid == adminId;
      allow update: if false;
      allow delete: if false;
    }
  }
}