/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-generated content (Members, Donations, and Transactions).
 * Users can only read, create, update, and delete data associated with their own user ID. Public read access is granted for DonationCategories.
 * Admin access is controlled by the existence of a document in the `/roles_admin` collection, granting elevated privileges.
 *
 * Data Structure:
 * - /users/{userId}/membre/{memberId}: Stores member profiles.
 * - /users/{userId}/donations/{donationId}: Stores donations.
 * - /users/{userId}/transactions/{transactionId}: Stores transactions.
 * - /donationCategories/{categoryId}: Stores global categories for donations (publicly readable).
 * - /roles_admin/{adminId}: Collection of admin users.
 *
 * Key Security Decisions:
 * - User-owned data is strictly controlled by the user's ID.
 * - Listing other user's data is disallowed.
 * - Public read access is granted to the `donationCategories` collection.
 * - Admin privileges are determined by the existence of a document in the `/roles_admin` collection.
 *
 * Denormalization for Authorization:
 *  - The rules leverage the hierarchical data structure (e.g., /users/{userId}/donations/{donationId}) to associate data with a specific user, avoiding the need for complex `get()` calls to determine ownership.
 *  - Admin status is determined by the existence of a document in the `/roles_admin` collection, which is directly checked by the `isAdmin()` function.
 *
 * Structural Segregation:
 *  - Public (donationCategories) and private (user-owned data) are stored in separate top-level collections to avoid the need for complex filtering rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by a signed-in user.
     * @param {string} userId - The user ID to check against.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @param {string} userId - The user ID to check against.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is an existing owner of the document.
     * @param {string} userId - The user ID to check against.
     * @return {bool} True if the user is an existing owner, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the authenticated user is an admin.
     * @return {bool} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for Member documents under a user.
     * @path /users/{userId}/membre/{memberId}
     * @allow (create) - Authenticated user can create a member if the userId in the path matches their auth.uid and the document id matches memberId.
     * @allow (update) - Authenticated user can update a member if the userId in the path matches their auth.uid.
     * @allow (delete) - Authenticated user can delete a member if the userId in the path matches their auth.uid.
     * @deny (create) - Deny creation if the userId in the path does not match their auth.uid.
     * @deny (update) - Deny update if the userId in the path does not match their auth.uid.
     * @deny (delete) - Deny delete if the userId in the path does not match their auth.uid.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/membre/{memberId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == memberId;
      allow update: if isExistingOwner(userId) && resource.data.id == request.resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for Donation documents under a user.
     * @path /users/{userId}/donations/{donationId}
     * @allow (create) - Authenticated user can create a donation if the userId in the path matches their auth.uid.
     * @allow (update) - Authenticated user can update a donation if the userId in the path matches their auth.uid.
     * @allow (delete) - Authenticated user can delete a donation if the userId in the path matches their auth.uid.
     * @deny (create) - Deny creation if the userId in the path does not match their auth.uid.
     * @deny (update) - Deny update if the userId in the path does not match their auth.uid.
     * @deny (delete) - Deny delete if the userId in the path does not match their auth.uid.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/donations/{donationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.memberId == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for Transaction documents under a user.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (create) - Authenticated user can create a transaction if the userId in the path matches their auth.uid.
     * @allow (update) - Authenticated user can update a transaction if the userId in the path matches their auth.uid.
     * @allow (delete) - Authenticated user can delete a transaction if the userId in the path matches their auth.uid.
     * @deny (create) - Deny creation if the userId in the path does not match their auth.uid.
     * @deny (update) - Deny update if the userId in the path does not match their auth.uid.
     * @deny (delete) - Deny delete if the userId in the path does not match their auth.uid.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/transactions/{transactionId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for DonationCategory documents.
     * @path /donationCategories/{categoryId}
     * @allow (get, list) - Any user can read donation categories.
     * @deny (create, update, delete) - Only admins can create, update, or delete donation categories.
     * @principle Public read, admin-only writes.
     */
    match /donationCategories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for Admin documents.
     * @path /roles_admin/{adminId}
     * @allow (get) - Only the admin user can get their own admin document.
     * @allow (create) - Only an admin can create another admin.
     * @allow (update) - Only the admin user can update their own admin document.
     * @allow (delete) - Only an admin can delete another admin document.
     * @deny (get) - Deny if the user is not an admin or not trying to get their own document.
     * @principle Admin-only access.
     */
    match /roles_admin/{adminId} {
      allow get: if isAdmin() && request.auth.uid == adminId;
      allow create: if isAdmin();
      allow update: if isAdmin() && request.auth.uid == adminId;
      allow delete: if isAdmin();
    }
  }
}