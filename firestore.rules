/**
 * @file Firebase Security Rules for the association app.
 *
 * @Core Philosophy
 * This ruleset enforces a strict user-ownership model for member data and related donations/CERFA forms.
 * Only authenticated users can access data, and they can only access data related to their own member ID.
 * Public listing of any data is disallowed.
 *
 * @Data Structure
 * - /members/{memberId}: Stores member profiles.
 * - /members/{memberId}/donations/{donationId}: Stores donations made by each member.
 * - /members/{memberId}/donations/{donationId}/cerfa/{cerfaId}: Stores CERFA forms associated with each donation.
 * - /donationCategories/{donationCategoryId}: Stores donation categories. This collection is publicly readable, but only authenticated users can create, update, and delete categories.
 *
 * @Key Security Decisions
 * - User listing is disallowed to prevent unauthorized access to member data.
 * - All write operations (create, update, delete) are strictly controlled by ownership.
 * - Data consistency between the path and the document's internal fields is enforced on creation and updates.
 * - The donationCategories collection is publicly readable to enable easy access to donation categories but is protected by authentication for write access.
 *
 * @Denormalization for Authorization
 * - Donations store the `memberId` to allow direct authorization checks without needing to read the parent member document.
 * - CERFA forms store the `donationId` to allow direct authorization checks without needing to read the parent donation document.
 *
 * @Structural Segregation
 * - Member profiles, donations, CERFA forms, and donation categories are stored in separate collections to enforce distinct security requirements.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by an authenticated user.
     * @return {boolean} True if the user is authenticated, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the existing owner of the resource.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for member profiles.
     * @path /members/{memberId}
     * @allow (create) If the user is creating their own profile (auth.uid == memberId).
     * @allow (get, update, delete) If the user is the owner of the profile.
     * @deny (create) If the user is not authenticated.
     * @deny (get, update, delete) If the user is not the owner of the profile.
     * @principle Enforces document ownership for all operations.
     */
    match /members/{memberId} {
      allow get: if isOwner(memberId);
      allow list: if false;
      allow create: if isOwner(memberId) && request.resource.data.id == memberId;
      allow update: if isExistingOwner(memberId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(memberId);
    }

    /**
     * @description Rules for donations made by each member.
     * @path /members/{memberId}/donations/{donationId}
     * @allow (create) If the user is the owner of the member profile and the donation's memberId matches the profile's memberId.
     * @allow (get, update, delete) If the user is the owner of the member profile and the donation's memberId matches the profile's memberId.
     * @deny (create, get, update, delete) If the user is not the owner of the member profile.
     * @principle Enforces document ownership for all operations and validates relational integrity.
     */
    match /members/{memberId}/donations/{donationId} {
      allow get: if isOwner(memberId);
      allow list: if isOwner(memberId);
      allow create: if isOwner(memberId) && request.resource.data.memberId == memberId;
      allow update: if isExistingOwner(memberId) && request.resource.data.memberId == resource.data.memberId;
      allow delete: if isExistingOwner(memberId);
    }

    /**
     * @description Rules for CERFA forms associated with each donation.
     * @path /members/{memberId}/donations/{donationId}/cerfa/{cerfaId}
     * @allow (create) If the user is the owner of the member profile and the donation's memberId matches the profile's memberId.
     * @allow (get, update, delete) If the user is the owner of the member profile and the donation's memberId matches the profile's memberId.
     * @deny (create, get, update, delete) If the user is not the owner of the member profile.
     * @principle Enforces document ownership for all operations and validates relational integrity.
     */
    match /members/{memberId}/donations/{donationId}/cerfa/{cerfaId} {
      allow get: if isOwner(memberId);
      allow list: if isOwner(memberId);
      allow create: if isOwner(memberId);
      allow update: if isExistingOwner(memberId);
      allow delete: if isExistingOwner(memberId);
    }

    /**
     * @description Rules for donation categories.
     * @path /donationCategories/{donationCategoryId}
     * @allow (get, list) Allow public read access to donation categories.
     * @allow (create, update, delete) Only authenticated users can create, update, and delete donation categories.
     * @deny (create, update, delete) If the user is not authenticated.
     * @principle Allows public read access but restricts write access to authenticated users.
     */
    match /donationCategories/{donationCategoryId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }
  }
}