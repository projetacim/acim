/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model with user-owned data.
 *
 * Data Structure:
 * - /users/{userId}/...:  All data is nested under a user's ID, providing strict ownership.
 * - /donationCategories/{categoryId}: Public read, owner-only write access.
 * - /roles_admin/{adminId}: Existence of a document in this collection grants admin privileges.
 *
 * Key Security Decisions:
 * - Users can only access data under their own user ID.
 * - Public listing is enabled for donation categories.
 * - Only admins can create, update, or delete donation categories.
 *
 * Denormalization for Authorization:
 *  - Admin status is determined by the existence of a document in the `/roles_admin/{adminId}` collection, where `{adminId}` is the user's UID.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Authentication is required for most operations.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the resource.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces user-based ownership.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an existing owner of the resource.
     *              This means the user is the owner and the resource exists.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces user-based ownership and resource existence for destructive operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && exists(resource.__name__);
    }

    /**
     * @description Checks if the user is an admin based on their UID existing as a document ID in the /roles_admin collection.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Implements role-based access control for administrative functions.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for documents in the /users/{userId}/membre/{memberId} path.
     * @path /users/{userId}/membre/{memberId}
     * @allow (create) If the user's UID matches the {userId} path parameter.
     * @deny (create) If the user's UID does not match the {userId} path parameter.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/membre/{memberId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Rules for documents in the /users/{userId}/donations/{donationId} path.
     * @path /users/{userId}/donations/{donationId}
     * @allow (create) If the user's UID matches the {userId} path parameter.
     * @deny (create) If the user's UID does not match the {userId} path parameter.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/donations/{donationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Rules for documents in the /users/{userId}/transactions/{transactionId} path.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (create) If the user's UID matches the {userId} path parameter.
     * @deny (create) If the user's UID does not match the {userId} path parameter.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/transactions/{transactionId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Rules for documents in the /donationCategories/{categoryId} path.
     * @path /donationCategories/{categoryId}
     * @allow (get, list) Public read access.
     * @allow (create, update, delete) Only admins can modify donation categories.
     * @deny (create, update, delete) Non-admins cannot modify donation categories.
     * @principle Public read access with admin-only writes.
     */
    match /donationCategories/{categoryId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Rules for documents in the /roles_admin/{adminId} path.
     * @path /roles_admin/{adminId}
     * @allow (create) Only allow if the authenticated user's ID matches the document ID. This allows admins to self-create their admin document.
     * @deny (create) If the authenticated user's ID does not match the document ID.
     */
    match /roles_admin/{adminId} {
      allow get: if isSignedIn() && isAdmin();
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == adminId;
      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid == adminId;
    }
  }
}