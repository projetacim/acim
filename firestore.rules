/**
 * @file Firebase Security Rules for Firestore.
 *
 * @Core Philosophy:
 * This ruleset enforces a user-ownership model where members and their donations are nested under `/users/{userId}`, ensuring only the authenticated user can manage their own data.
 * Additionally, it implements an admin role system where only users with a document in `/roles_admin/{adminId}` are considered administrators.
 *
 * @Data Structure:
 * - `/users/{userId}/membre/{memberId}`: Member profiles, accessible only by the owning user.
 * - `/users/{userId}/membre/{memberId}/donations/{donationId}`: Donations made by a specific member.
 * - `/users/{userId}/membre/{memberId}/donations/{donationId}/cerfa/{cerfaId}`: CERFA forms for donations.
 * - `/roles_admin/{adminId}`: Admin role definitions, where the document ID matches the user's UID.
 *
 * @Key Security Decisions:
 * - Members can only manage their own data (create, update, delete donations and CERFA forms under their member ID).
 * - Only administrators can manage members.
 * - Listing of members is restricted to administrators only.
 * - Admin role creation is restricted to the user whose UID matches the document ID, preventing unauthorized elevation of privileges.
 *
 * @Denormalization for Authorization:
 * - The presence of a document in `/roles_admin/{adminId}` acts as a denormalized flag for admin privileges, avoiding the need for complex queries.
 * - Path-based ownership under `/users/{userId}` simplifies authorization checks for member data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is an admin.
     */
    function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the requested user ID matches the authenticated user's ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the existing document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /members/{memberId} collection.
     * @path /members/{memberId}
     * @allow (create) User with admin role can create a member.
     * @deny (create) User without admin role cannot create a member.
     * @allow (get) User with admin role can get a member.
     * @deny (get) User without admin role cannot get a member.
     * @principle Only admins can manage members.
     */
    match /members/{memberId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for the /members/{memberId}/donations/{donationId} collection.
     * @path /members/{memberId}/donations/{donationId}
     * @allow (create) Member or admin can create a donation for the member.
     * @deny (create) Non-member and non-admin cannot create a donation.
     * @allow (get) Member or admin can get a donation for the member.
     * @deny (get) Non-member and non-admin cannot create a donation.
     * @principle Members and admins can manage donations for a member.
     */
    match /members/{memberId}/donations/{donationId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for the /members/{memberId}/donations/{donationId}/cerfa/{cerfaId} collection.
     * @path /members/{memberId}/donations/{donationId}/cerfa/{cerfaId}
     * @allow (create) Member or admin can create a CERFA form for the donation.
     * @deny (create) Non-member and non-admin cannot create a CERFA form.
     * @allow (get) Member or admin can get a CERFA form for the donation.
     * @deny (get) Non-member and non-admin cannot create a CERFA form.
     * @principle Members and admins can manage CERFA forms for a donation.
     */
    match /members/{memberId}/donations/{donationId}/cerfa/{cerfaId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for the /roles_admin/{adminId} collection.
     * @path /roles_admin/{adminId}
     * @allow (create) Any signed-in user can create an admin role document, but only if their UID matches the document ID.
     * @deny (create) A signed-in user cannot create an admin role document if their UID does not match the document ID.
     * @allow (get) Any signed-in user can get an admin role document, but only if their UID matches the document ID.
     * @deny (get) A signed-in user cannot get an admin role document if their UID does not match the document ID.
     * @principle Only the user with the matching UID can create or read their admin role document.
     */
    match /roles_admin/{adminId} {
      allow get: if isOwner(adminId);
      allow list: if false; // Only admins can know the other admins!
      allow create: if isSignedIn() && request.auth.uid == adminId;
      allow update: if false;
      allow delete: if request.auth.uid == adminId;
    }

    /**
     * @description Rules for the /users/{userId}/membre/{memberId} collection.
     * @path /users/{userId}/membre/{memberId}
     * @allow (create) User can create a member if the userId matches the authenticated user's ID.
     * @deny (create) User cannot create a member if the userId does not match the authenticated user's ID.
     * @allow (get) User can get their own member document.
     * @deny (get) User cannot get another user's member document.
     * @principle Enforces user-ownership for member profiles.
     */
    match /users/{userId}/membre/{memberId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) ;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Rules for the /users/{userId}/membre/{memberId}/donations/{donationId} collection.
     * @path /users/{userId}/membre/{memberId}/donations/{donationId}
     * @allow (create) User can create a donation under their member profile.
     * @deny (create) User cannot create a donation under another user's member profile.
     * @allow (get) User can get donations under their member profile.
     * @deny (get) User cannot get donations under another user's member profile.
     * @principle Enforces user-ownership for donations.
     */
    match /users/{userId}/membre/{memberId}/donations/{donationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Rules for the /users/{userId}/membre/{memberId}/donations/{donationId}/cerfa/{cerfaId} collection.
     * @path /users/{userId}/membre/{memberId}/donations/{donationId}/cerfa/{cerfaId}
     * @allow (create) User can create a CERFA form under their donation.
     * @deny (create) User cannot create a CERFA form under another user's donation.
     * @allow (get) User can get CERFA forms under their donation.
     * @deny (get) User cannot get CERFA forms under another user's donation.
     * @principle Enforces user-ownership for CERFA forms.
     */
    match /users/{userId}/membre/{memberId}/donations/{donationId}/cerfa/{cerfaId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }
}