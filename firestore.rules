/**
 * @fileOverview Firestore Security Rules for the association app.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for member data,
 * with granular access control for donations and CERFA forms.
 * Donation categories are managed separately in a top-level collection.
 *
 * Data Structure:
 * - /members/{memberId}: Stores member profiles. Only the owning user can read/write.
 * - /members/{memberId}/donations/{donationId}: Stores donations made by a member.
 *   Only the owning member can manage their donations.
 * - /members/{memberId}/donations/{donationId}/cerfa/{cerfaId}: Stores CERFA forms
 *   associated with donations. Only the owning member can manage CERFA forms.
 * - /donationCategories/{donationCategoryId}: Stores donation categories.
 *   Currently, anyone can read or create donation categories.
 *
 * Key Security Decisions:
 * - User listing is disallowed for privacy.
 * - Data is denormalized to enable efficient security rules without extra reads.
 * - The rules explicitly deny any unauthorized access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to member profiles.
     * @path /members/{memberId}
     * @allow (create) - Authenticated user can create their own profile if the memberId matches their UID.
     * @allow (get, list, update, delete) - Authenticated user can only access their own profile.
     * @deny (create) - If the memberId does not match the authenticated user's UID.
     * @deny (update, delete) - If the member does not exist.
     * @principle Enforces document ownership for writes.
     */
    match /members/{memberId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(memberId);
      allow list: if false;
      allow create: if isOwner(memberId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(memberId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(memberId);
    }

    /**
     * @description Controls access to donations made by a member.
     * @path /members/{memberId}/donations/{donationId}
     * @allow (create) - Authenticated user can create a donation under their profile.
     * @allow (get, list, update, delete) - Authenticated user can only access donations under their profile.
     * @deny (create) - If the memberId does not match the authenticated user's UID.
     * @deny (update, delete) - If the donation does not exist.
     * @principle Restricts access to a user's own data tree.
     */
    match /members/{memberId}/donations/{donationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

       function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(memberId);
      allow list: if isOwner(memberId);
      allow create: if isOwner(memberId);
      allow update: if isExistingOwner(memberId);
      allow delete: if isExistingOwner(memberId);
    }

    /**
     * @description Controls access to CERFA forms associated with a donation.
     * @path /members/{memberId}/donations/{donationId}/cerfa/{cerfaId}
     * @allow (create) - Authenticated user can create a CERFA form under their donation.
     * @allow (get, list, update, delete) - Authenticated user can only access CERFA forms under their donation.
     * @deny (create) - If the memberId does not match the authenticated user's UID.
     * @deny (update, delete) - If the cerfa does not exist.
     * @principle Restricts access to a user's own data tree.
     */
    match /members/{memberId}/donations/{donationId}/cerfa/{cerfaId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

       function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(memberId);
      allow list: if isOwner(memberId);
      allow create: if isOwner(memberId);
      allow update: if isExistingOwner(memberId);
      allow delete: if isExistingOwner(memberId);
    }

    /**
     * @description Controls access to donation categories.
     * @path /donationCategories/{donationCategoryId}
     * @allow (get, list) - Anyone can read donation categories.
     * @allow (create) - Anyone can create donation categories.
     * @deny (update, delete) - No one can update or delete donation categories.
     */
    match /donationCategories/{donationCategoryId} {
        function isSignedIn() {
            return request.auth != null;
        }
        allow get, list: if true;
        allow create: if isSignedIn();
        allow update: if false;
        allow delete: if false;
    }
  }
}